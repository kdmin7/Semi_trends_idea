# ==========================================
# URL Monitor & Digest Agent Secrets Template
# (복사하여 .env 파일을 만들고 실제 키를 입력하세요)
# ==========================================

# Resend Email API Key (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Firecrawl Web Scraper API Key (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here

# Anthropic Claude API Key (https://console.anthropic.com) - 한국어 요약 생성용
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# 메일 수신자 (Resend 테스트 단계에서는 가입 계정 본인 주소만 가능)
EMAIL_RECIPIENT=you@example.com
